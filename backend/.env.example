# ─── Auth: pick ONE path ─────────────────────────────────────────────────────
#
# PATH A — Vertex AI (RECOMMENDED for hackathon — uses GCP credits)
USE_VERTEX_AI=true
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
#
# Before starting the server, run once:
#   gcloud auth application-default login
#
# PATH B — AI Studio API key (requires paid Gemini API tier)
# GEMINI_API_KEY=
# USE_VERTEX_AI=false

# ─── Optional (Day 1 works without these) ────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Feature flags ───────────────────────────────────────────────────────────
# Enable real Google Places API (costs credits); default off — Discovery uses mock data
USE_REAL_PLACES=false
# Stream trace steps to stdout for local debugging
DEBUG_TRACES=true

# ─── Runtime tuning ──────────────────────────────────────────────────────────
PORT=8080
# Free-tier-friendly default; set GEMINI_MODEL=gemini-2.5-pro when billing is enabled
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash
MAX_STEPS=12
AGENT_TIMEOUT_MS=30000
RUN_TIMEOUT_MS=90000

# ─── Per-agent model overrides (optional) ────────────────────────────────────
# MODEL_ORCHESTRATOR=gemini-2.5-pro
# MODEL_INTENT=gemini-2.5-flash
# MODEL_DISCOVERY=gemini-2.5-flash
# MODEL_RANKING=gemini-2.5-pro
# MODEL_BOOKING=gemini-2.5-flash
# MODEL_FOLLOWUP=gemini-2.5-flash
